\name{svmf.mle}
\alias{svmf.mle}
\title{
Maximum likelihood estimation of the scaled von Mises--Fisher distribution
}

\description{
Maximum likelihood estimation of the scaled von Mises--Fisher distribution.
}

\usage{
svmf.mle(y, a1 = 1, maxit_outer = 100, maxit_V = 500, tol = 1e-6)
}

\arguments{
\item{y}{
A numerical matrix with the (hyper-)spherical observations.
}
\item{a1}{
The value of the \eqn{\alpha_1} parameter is set to 1 , as suggested by Scealy and Wood (2019).
}
\item{maxit_outer}{
The maximum number of iterations to perform.
}
\item{maxit_V}{
The maximum number of iterations to perform to estimate the \eqn{\bm{V}} matrix.
}
\item{tol}{
The tolerance value until convergence of the log-likelihood.
}
}

\value{
A list including:
\item{mu}{
The estimated mean direction.
}
\item{kappa}{
The estimated concentration partameter.
}
\item{a}{
The estimated vector of alphas, the first value is 1, by default.
}
\item{loglik}{
the log-likelihood value.
}
\item{Gamma}{
The estimated matrix with the \eqn{\bm{\gamma}} vectors. The first column of this matrix is the mean direction.
}
}

\references{
Scealy J.L. and Wood A.T.A. (2019). Scaled von Mises–Fisher distributions and regression models for paleomagnetic directional data.
Journal of the American Statistical Association, 114(528):  1547--1560.
}

\author{
Michail Tsagris.

R implementation and documentation: Michail Tsagris \email{mtsagris@uoc.gr}.
}

%\note{
%%  ~~further notes~~
%}

\seealso{
\code{\link{rsvmf}
}
}

\examples{
mu <- rnorm(3)
mu <- mu / sqrt( sum(mu^2) )
a <- c(1, 3, 1/3)
y <- rsvmf(1000, mu, a, 20)
svmf.mle(y)
}
